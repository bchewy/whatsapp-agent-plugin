# Runtime state and private WhatsApp data.
whatsapp/build/vendor/whatsapp-mcp/whatsapp-bridge/store/
*.db
*.db-shm
*.db-wal

# The plugin intentionally packages its vendored runtime under build/ so
# prompt/eval tooling does not treat runtime implementation files as deferred
# skill documentation.
build/
!whatsapp/build/
!whatsapp/build/vendor/
!whatsapp/build/vendor/whatsapp-mcp/
!whatsapp/build/vendor/whatsapp-mcp/**

# Python and Go build artifacts.
.venv/
__pycache__/
*.py[cod]
bin/
dist/

# Logs and temp files.
*.log
*.tmp
*.ogg.tmp
.DS_Store
.playwright-mcp/

# Compiled bridge binary (built locally by start-bridge.sh / go build).
whatsapp/build/vendor/whatsapp-mcp/whatsapp-bridge/whatsapp-client
